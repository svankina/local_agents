[Unit]
Description=Network-isolated Qwen3.6 27B Aggressive multimodal server
After=nvidia-driver-ready.service
Requires=nvidia-driver-ready.service

[Service]
Type=simple
User=llm
Group=llm
Environment=LD_LIBRARY_PATH=/opt/llama.cpp/lib:/opt/cuda/lib
ExecStart=/opt/llama.cpp/bin/llama-server \
  -m /opt/models/Qwen3.6-27B-Uncensored-HauhauCS-Aggressive-Q3_K_P.gguf \
  --mmproj /opt/models/mmproj-Qwen3.6-27B-Uncensored-HauhauCS-Aggressive-f16.gguf \
  --api-key-file /etc/llama/api.key \
  --offline \
  --no-ui \
  --no-slots \
  --parallel 1 \
  -ngl 99 \
  --jinja \
  -fa on \
  -c 262144 \
  --batch-size 512 \
  --ubatch-size 256 \
  --cache-type-k q4_0 \
  --cache-type-v q4_0 \
  --chat-template-kwargs '{"enable_thinking":true,"preserve_thinking":true}' \
  --temp 1.0 \
  --top-k 20 \
  --top-p 0.95 \
  --min-p 0.0 \
  --presence-penalty 1.5 \
  --repeat-penalty 1.0 \
  --cache-ram 0 \
  --host 127.0.0.1 \
  --port 8089
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/llama
UMask=0077

[Install]
WantedBy=multi-user.target
