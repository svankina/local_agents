[Unit]
Description=Network-isolated Gemma 4 31B QAT multimodal server
After=nvidia-driver-ready.service
Requires=nvidia-driver-ready.service

[Service]
Type=simple
User=llm
Group=llm
Environment=LD_LIBRARY_PATH=/opt/llama.cpp/lib:/opt/cuda/lib
ExecStart=/opt/llama.cpp/bin/llama-server \
  -m /opt/models/Gemma4-31B-QAT-Uncensored-HauhauCS-Balanced-Q4_K_M.gguf \
  --mmproj /opt/models/mmproj-Gemma4-31B-QAT-Uncensored-HauhauCS-Balanced-BF16.gguf \
  --no-mmproj-offload \
  --model-draft /opt/models/mtp-gemma-4-31B-it.gguf \
  --api-key-file /etc/llama/api.key \
  --offline \
  --no-ui \
  --no-slots \
  --parallel 1 \
  -ngl 99 \
  --jinja \
  -fa on \
  -c 131072 \
  --batch-size 512 \
  --ubatch-size 256 \
  --cache-type-k q4_0 \
  --cache-type-v q4_0 \
  --spec-type draft-mtp \
  --spec-draft-n-max 2 \
  --no-spec-draft-backend-sampling \
  --temp 0.6 \
  --top-k 64 \
  --top-p 0.9 \
  --min-p 0.05 \
  --repeat-penalty 1.1 \
  --cache-ram 0 \
  --host 127.0.0.1 \
  --port 8089
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/llama
UMask=0077

[Install]
WantedBy=multi-user.target
