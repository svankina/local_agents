[Unit]
Description=Expose llama-server only through host/guest vsock
After=llama-server.service
Requires=llama-server.service

[Service]
Type=simple
ExecStart=/usr/bin/socat VSOCK-LISTEN:8089,reuseaddr,fork TCP4-CONNECT:127.0.0.1:8089
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_VSOCK AF_INET
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
